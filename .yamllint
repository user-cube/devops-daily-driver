---
extends: default

ignore: |
  .ansible/

rules:
  line-length:
    max: 140
  comments:
    min-spaces-from-content: 1
  # GitHub Actions uses `on:` as a key, which YAML 1.1 reads as a boolean.
  truthy:
    allowed-values: ["true", "false", "on"]
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
